# Copy to .env and export variables as explained in README. Never commit .env.
DEMO_MODE=mock
DATABASE_URL=sqlite:///./clientflow_demo.sqlite3
# For public network exposure set a long random key and use HTTPS / reverse proxy.
ADMIN_API_KEY=
WEBHOOK_API_KEY=
DRY_RUN=false
LIVE_OUTBOUND_ENABLED=false
# Live connector scaffolding only, NOT enabled through the mock pipeline.
GHL_LOCATION_ID=
GHL_PRIVATE_INTEGRATION_TOKEN=
GHL_CALENDAR_ID=
GHL_PIPELINE_ID=
GHL_STAGE_BOOKED_ID=
# Optional: local-only Mailpit SMTP capture (never sends to real inboxes)
TEST_MAILPIT_ENABLED=false
TEST_MAILPIT_HOST=localhost
# Optional actual local Ollama advisory (install model separately)
OLLAMA_MODEL=
OLLAMA_URL=http://127.0.0.1:11434
# Provider webhooks stay OFF unless intentionally enabled with HTTPS, signatures and access rules.
ENABLE_PROVIDER_WEBHOOKS=false
VAPI_WEBHOOK_SECRET=
TWILIO_AUTH_TOKEN=
TWILIO_PUBLIC_WEBHOOK_URL=

# Provider integration activation — OFF by default. Test credentials ONLY.
GHL_STAGE_QUALIFIED_ID=
GHL_TEST_EMAIL_ALLOWLIST=
GHL_LIVE_TEST_WRITE_ENABLED=NO
TWILIO_ACCOUNT_SID=
TWILIO_FROM_NUMBER=
TWILIO_STATUS_CALLBACK_URL=
TWILIO_TEST_RECIPIENT_ALLOWLIST=
TWILIO_LIVE_TEST_WRITE_ENABLED=NO
ALLOW_REAL_WEBHOOK_CONTACTS=NO
# For Vapi configure the assistant's Server URL and X-Vapi-Secret credential.
# Public HTTPS hosting and correct proxy URL signing are required for webhook verification.
# Optional Vapi end-of-call → allowlisted authorized GHL test flow;
# requires full GHL IDs/permissions/consent. Disabled by default.
ENABLE_GHL_WEBHOOK_BRIDGE=false
